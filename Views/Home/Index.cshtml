@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-heading">
    <div><p class="eyebrow">Overview</p><h1>Dashboard</h1><p class="text-muted">A clear view of academic activity.</p></div>
    <a class="btn btn-primary" asp-controller="Students" asp-action="Create">+ Add student</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-card"><span class="stat-icon blue">S</span><div><span>Students</span><strong>@Model.TotalStudents</strong></div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span class="stat-icon violet">C</span><div><span>Courses</span><strong>@Model.TotalCourses</strong></div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span class="stat-icon green">E</span><div><span>Enrollments</span><strong>@Model.TotalEnrollments</strong></div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span class="stat-icon amber">G</span><div><span>Average GPA</span><strong>@(Model.AverageGrade?.ToString("0.00") ?? "—")</strong></div></div></div>
</div>
<div class="panel">
    <div class="panel-header"><div><h2>Recent enrollments</h2><p>Latest course registrations</p></div><a asp-controller="Enrollments" asp-action="Index">View all →</a></div>
    @if (Model.RecentEnrollments.Count == 0) { <partial name="_EmptyState" model="@("Enroll a student to see recent activity.")" /> }
    else {
    <div class="table-responsive"><table class="table align-middle">
        <thead><tr><th>Student</th><th>Course</th><th>Date</th><th>Grade</th></tr></thead>
        <tbody>@foreach (var item in Model.RecentEnrollments) {
            <tr><td class="fw-semibold">@item.Student?.FullName</td><td><span class="course-code">@item.Course?.Code</span> @item.Course?.Title</td><td>@item.EnrollmentDate.ToString("MMM d, yyyy")</td><td><span class="badge-soft">@item.Grade.ToString().Replace("InProgress", "In Progress")</span></td></tr>
        }</tbody>
    </table></div>}
</div>
