@model IEnumerable<Enrollment>
@{ ViewData["Title"]="Enrollments"; }
<div class="page-heading"><div><p class="eyebrow">Academic records</p><h1>Enrollments</h1><p class="text-muted">Manage registrations and grades.</p></div><a class="btn btn-primary" asp-action="Create">+ New enrollment</a></div><div class="panel table-responsive">@if(!Model.Any()){<partial name="_EmptyState" model="@("Create an enrollment to begin tracking grades.")" />}else{<table class="table align-middle mb-0"><thead><tr><th>Student</th><th>Course</th><th>Enrollment date</th><th>Grade</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a class="entity-link" asp-controller="Students" asp-action="Details" asp-route-id="@item.StudentId">@item.Student?.FullName</a></td><td><span class="course-code">@item.Course?.Code</span> @item.Course?.Title</td><td>@item.EnrollmentDate.ToString("MMM d, yyyy")</td><td><span class="badge-soft">@item.Grade.ToString().Replace("InProgress","In Progress")</span></td><td class="text-end action-links"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="text-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>}</div>
