@model Student
@{ ViewData["Title"] = "Delete student"; }
<div class="form-shell"><a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Student profile</a><div class="panel danger-panel"><h1>Delete @Model.FullName?</h1><p>This permanently removes the student and @Model.Enrollments.Count related enrollment(s). This action cannot be undone.</p><form method="post"><input type="hidden" asp-for="Id" /><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a> <button class="btn btn-danger">Delete student</button></form></div></div>
