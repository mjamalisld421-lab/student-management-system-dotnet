@model Student
@{ ViewData["Title"] = Model.FullName; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Students</a><h1>@Model.FullName</h1><p class="text-muted">@Model.Department</p></div><div><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Id">Edit profile</a> <a class="btn btn-primary" asp-controller="Enrollments" asp-action="Create" asp-route-studentId="@Model.Id">Enroll in course</a></div></div>
<div class="row g-4"><div class="col-lg-4"><div class="panel detail-list"><h2>Profile</h2><dl><dt>Email</dt><dd>@Model.Email</dd><dt>Phone</dt><dd>@(Model.Phone ?? "—")</dd><dt>Date of birth</dt><dd>@(Model.DateOfBirth?.ToString("MMM d, yyyy") ?? "—")</dd><dt>Enrollment date</dt><dd>@Model.EnrollmentDate.ToString("MMM d, yyyy")</dd><dt>Status</dt><dd><span class="status status-@Model.Status.ToString().ToLower()">@Model.Status</span></dd></dl></div></div>
<div class="col-lg-8"><div class="panel"><div class="panel-header"><div><h2>Course history</h2><p>@Model.Enrollments.Count enrollment(s)</p></div></div>@if (!Model.Enrollments.Any()) { <partial name="_EmptyState" model="@("This student has no course enrollments.")" /> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Course</th><th>Date</th><th>Grade</th></tr></thead><tbody>@foreach(var e in Model.Enrollments.OrderByDescending(x => x.EnrollmentDate)){<tr><td><span class="course-code">@e.Course?.Code</span> @e.Course?.Title</td><td>@e.EnrollmentDate.ToString("MMM d, yyyy")</td><td>@e.Grade.ToString().Replace("InProgress","In Progress")</td></tr>}</tbody></table></div>}</div></div></div>
