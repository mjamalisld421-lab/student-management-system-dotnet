@model Course
@{ ViewData["Title"]=Model.Code; }
<div class="page-heading"><div><a class="back-link" asp-action="Index">← Courses</a><h1><span class="course-code">@Model.Code</span> @Model.Title</h1><p class="text-muted">@Model.Department · @Model.Credits credits</p></div><a class="btn btn-light" asp-action="Edit" asp-route-id="@Model.Id">Edit course</a></div><div class="panel mb-4"><h2>About this course</h2><p class="mb-0">@(Model.Description ?? "No description provided.")</p></div><div class="panel"><div class="panel-header"><div><h2>Enrolled students</h2><p>@Model.Enrollments.Count enrollment(s)</p></div></div>@if(!Model.Enrollments.Any()){<partial name="_EmptyState" model="@("No students are enrolled in this course.")" />}else{<div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Date</th><th>Grade</th></tr></thead><tbody>@foreach(var e in Model.Enrollments){<tr><td><a class="entity-link" asp-controller="Students" asp-action="Details" asp-route-id="@e.StudentId">@e.Student?.FullName</a></td><td>@e.EnrollmentDate.ToString("MMM d, yyyy")</td><td>@e.Grade.ToString().Replace("InProgress","In Progress")</td></tr>}</tbody></table></div>}</div>
