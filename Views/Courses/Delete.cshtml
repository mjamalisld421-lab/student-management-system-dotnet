@model Course
@{ ViewData["Title"]="Delete course"; }
<div class="form-shell"><a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Course details</a><div class="panel danger-panel"><h1>Delete @Model.Code?</h1><p>This permanently removes <strong>@Model.Title</strong> and @Model.Enrollments.Count related enrollment(s). This action cannot be undone.</p><form method="post"><input type="hidden" asp-for="Id"/><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a> <button class="btn btn-danger">Delete course</button></form></div></div>
