@model IEnumerable<Course>
@{ ViewData["Title"] = "Courses"; }
<div class="page-heading"><div><p class="eyebrow">Catalog</p><h1>Courses</h1><p class="text-muted">Maintain the academic course catalog.</p></div><a class="btn btn-primary" asp-action="Create">+ Add course</a></div>
<form method="get" class="filter-bar"><input class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Search title, code, or department" /><button class="btn btn-dark">Search</button><a class="btn btn-light" asp-action="Index">Reset</a></form>
<div class="panel table-responsive">@if(!Model.Any()){<partial name="_EmptyState" model="@("No courses match your search.")" />}else{<table class="table align-middle mb-0"><thead><tr><th>Code</th><th>Course</th><th>Department</th><th>Credits</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><span class="course-code">@item.Code</span></td><td><a class="entity-link" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td><td>@item.Department</td><td>@item.Credits</td><td class="text-end action-links"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="text-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table>}</div>
